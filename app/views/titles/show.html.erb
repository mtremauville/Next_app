<div class="container py-4">
  <div class="row g-4">
    <div class="col-4 col-md-3">
      <% if @title.poster_path %>
        <%= image_tag "https://image.tmdb.org/t/p/w342#{@title.poster_path}", class: "img-fluid rounded", alt: @title.name %>
      <% else %>
        <div class="bg-secondary-subtle rounded" style="aspect-ratio: 2 / 3;"></div>
      <% end %>
    </div>

    <div class="col-8 col-md-9">
      <h1><%= @title.name %></h1>
      <p class="text-muted">
        <%= @title.kind.humanize %>
        <% if @title.release_date %>
          · <%= @title.release_date.year %>
        <% end %>
      </p>
      <p><%= @title.overview %></p>

      <% if @watchlist_entry %>
        <%= button_to "Retirer de ma watchlist", watchlist_entry_path(@watchlist_entry), method: :delete, class: "btn btn-outline-danger" %>
      <% else %>
        <%= button_to "Ajouter à ma watchlist", watchlist_entries_path(title_id: @title.id), method: :post, class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>
</div>
