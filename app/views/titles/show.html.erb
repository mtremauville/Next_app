<div class="container py-4">
  <%= link_to "← Retour", @back_url || titles_path, class: "btn btn-sm btn-outline-secondary mb-3" %>

  <div class="row g-4">
    <div class="col-4 col-md-3">
      <% if @title.poster_path %>
        <%= image_tag "https://image.tmdb.org/t/p/w342#{@title.poster_path}", class: "img-fluid rounded", alt: @title.name %>
      <% else %>
        <div class="bg-secondary-subtle rounded" style="aspect-ratio: 2 / 3;"></div>
      <% end %>
    </div>

    <div class="col-8 col-md-9">
      <h1><%= @title.name %></h1>
      <p class="text-muted">
        <%= @title.kind.humanize %>
        <% if @title.release_date %>
          · <%= @title.release_date.year %>
        <% end %>
      </p>
      <p><%= @title.overview %></p>

      <% if @watchlist_entry %>
        <%= button_to "Retirer de ma watchlist", watchlist_entry_path(@watchlist_entry, back: @back_url), method: :delete, class: "btn btn-outline-danger" %>
      <% else %>
        <%= button_to "Ajouter à ma watchlist", watchlist_entries_path(title_id: @title.id, back: @back_url), method: :post, class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>

  <% if @title.tv_series? %>
    <div class="mt-4">
      <% total_episodes = @title.episodes.count %>
      <% watched_total = @watched_episode_ids.size %>
      <div class="mb-3">
        <div class="d-flex justify-content-between small text-muted mb-1">
          <span>Progression globale</span>
          <span><%= watched_total %> / <%= total_episodes %></span>
        </div>
        <div class="progress" style="height: 6px;">
          <div class="progress-bar" role="progressbar"
               style="width: <%= total_episodes.zero? ? 0 : (watched_total * 100.0 / total_episodes).round %>%"></div>
        </div>
      </div>

      <% @title.seasons.order(:number).each do |season| %>
        <% episodes = season.episodes.order(:number).to_a %>
        <% season_watched = episodes.count { |episode| @watched_episode_ids.include?(episode.id) } %>
        <div class="d-flex justify-content-between align-items-center mt-3">
          <h5 class="mb-0">Saison <%= season.number %></h5>
          <span class="small text-muted"><%= season_watched %> / <%= episodes.size %></span>
        </div>
        <ul class="list-group mb-3">
          <% episodes.each do |episode| %>
            <li class="list-group-item">
              <div class="d-flex justify-content-between align-items-center gap-2">
                <button type="button" class="btn btn-link p-0 text-start text-decoration-none text-body flex-grow-1"
                        data-bs-toggle="collapse" data-bs-target="#episode-overview-<%= episode.id %>">
                  <%= episode.number %>. <%= episode.name %>
                </button>
                <% watched = @watched_episode_ids.include?(episode.id) %>
                <%= button_to watched ? "Vu ✓" : "Marquer vu",
                              toggle_watched_episode_path(episode, back: @back_url), method: :post,
                              class: "btn btn-sm text-nowrap #{watched ? 'btn-success' : 'btn-outline-secondary'}" %>
              </div>
              <div class="collapse mt-2" id="episode-overview-<%= episode.id %>">
                <p class="text-muted small mb-0"><%= episode.overview.presence || "Pas de description disponible." %></p>
              </div>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>
  <% end %>
</div>
