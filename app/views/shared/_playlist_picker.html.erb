<section class="nerv-panel nerv-picker">
  <h2>Playlist</h2>

  <% if entry %>
    <p class="nerv-hint">Dans ta liste : <%= status_label(entry.status) %></p>
  <% end %>

  <% if entry&.playlist %>
    <p>Dans la playlist <strong><%= entry.playlist.name %></strong></p>
    <%= button_to "[ Retirer de la playlist ]",
          catalog_entry_playlist_removal_path(media_type: media_type, tmdb_id: tmdb_id),
          method: :delete, class: "nerv-link-button" %>
  <% end %>

  <% if playlists.any? %>
    <% in_playlist = entry&.playlist.present? %>
    <%= form_with url: catalog_entry_playlist_path(media_type: media_type, tmdb_id: tmdb_id), method: :post do %>
      <%= label_tag :playlist_id, in_playlist ? "Déplacer vers" : "Ajouter à une playlist" %>
      <%= select_tag :playlist_id, options_from_collection_for_select(playlists, :id, :name, entry&.playlist_id) %>
      <div class="nerv-actions">
        <%= submit_tag(in_playlist ? "[ Déplacer ]" : "[ Ajouter ]", name: nil) %>
      </div>
    <% end %>
  <% else %>
    <p class="nerv-hint">Aucune playlist pour l'instant. <%= link_to "[ Créer une playlist ]", new_playlist_path %></p>
  <% end %>
</section>
