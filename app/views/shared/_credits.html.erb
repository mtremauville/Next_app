<% if title.crew.any? %>
  <section class="nerv-panel nerv-section">
    <h2><%= t("title_page.crew") %></h2>
    <dl class="nerv-crew">
      <% title.crew.each do |key, names| %>
        <dt><%= crew_label(key) %></dt>
        <dd><%= names.join(", ") %></dd>
      <% end %>
    </dl>
  </section>
<% end %>

<% if title.cast.any? %>
  <section class="nerv-section">
    <h2><%= t("title_page.cast") %></h2>
    <ul class="nerv-cast">
      <% title.cast.each do |person| %>
        <li class="nerv-cast-item nerv-panel">
          <% if person.photo_path.present? %>
            <%= image_tag tmdb_image_url(person.photo_path, "w185"), alt: "", loading: "lazy" %>
          <% else %>
            <div class="nerv-poster-fallback" aria-hidden="true"><%= person.name.to_s.first.to_s.upcase %></div>
          <% end %>
          <span class="nerv-cast-name"><%= person.name %></span>
          <% if person.role %><span class="nerv-cast-role"><%= person.role %></span><% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
