<footer class="nerv-footer">
  <div class="nerv-footer-inner">
    <p><%= t("footer.copyright", year: Date.current.year) %></p>

    <nav aria-label="<%= t("footer.legal_label") %>">
      <%= link_to t("footer.terms"), terms_path %>
      <%= link_to t("footer.privacy"), privacy_path %>
    </nav>

    <p class="nerv-footer-credit">
      <%= t("footer.credit_html", tmdb: link_to("TMDB", "https://www.themoviedb.org", target: "_blank", rel: "noopener")) %>
    </p>
  </div>
</footer>
