<section class="nerv-auth">
  <div class="nerv-hero">
    <h1>Next</h1>
    <p class="nerv-tagline">// <%= t("auth.tagline") %></p>
    <p><%= t("auth.pitch") %></p>
    <%= button_to "[ #{t("auth.try_demo")} ]", guest_login_path, method: :post, class: "nerv-primary" %>
    <p class="nerv-hint"><%= t("auth.demo_hint") %></p>
    <%= render "shared/locale_switcher" %>
  </div>

  <div class="nerv-panel nerv-auth-form">
    <h2><%= t("auth.sign_in") %></h2>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <%= f.label :email, t("auth.email") %>
      <%= f.email_field :email, autocomplete: "email" %>

      <%= f.label :password, t("auth.password") %>
      <%= f.password_field :password, autocomplete: "current-password" %>

      <% if devise_mapping.rememberable? %>
        <div class="nerv-check">
          <%= f.check_box :remember_me %>
          <%= f.label :remember_me, t("auth.remember_me") %>
        </div>
      <% end %>

      <div class="nerv-actions">
        <%= f.submit "[ #{t("auth.submit")} ]" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</section>

<div data-controller="privacy-notice">
  <dialog class="nerv-modal nerv-modal--wide" aria-labelledby="privacy-notice-title"
          data-privacy-notice-target="dialog" data-action="close->privacy-notice#remember">
    <div class="nerv-panel">
      <h2 id="privacy-notice-title"><%= t("privacy_notice.title") %></h2>

      <div class="nerv-modal-body">
        <p><%= t("privacy_notice.intro") %></p>
        <ul>
          <li><%= t("privacy_notice.item_account") %></li>
          <li><%= t("privacy_notice.item_content") %></li>
          <li><%= t("privacy_notice.item_logs") %></li>
        </ul>
        <p><%= t("privacy_notice.cookies") %></p>
        <p><%= t("privacy_notice.third_parties") %></p>
        <p><%= t("privacy_notice.demo") %></p>
      </div>

      <div class="nerv-actions">
        <button type="button" class="nerv-primary" data-action="privacy-notice#close">[ <%= t("privacy_notice.ok") %> ]</button>
        <%= link_to "[ #{t("privacy_notice.policy")} ]", privacy_path %>
      </div>
    </div>
  </div>
</div>
