<section class="nerv-auth nerv-auth--single">
  <div class="nerv-panel nerv-auth-form">
    <h2><%= t("account.sign_up_title") %></h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <%= f.label :email, t("auth.email") %>
      <%= f.email_field :email, autocomplete: "email" %>

      <%= f.label :password do %>
        <%= t("auth.password") %>
        <% if @minimum_password_length %><span class="nerv-hint"><%= t("account.password_hint", count: @minimum_password_length) %></span><% end %>
      <% end %>
      <%= f.password_field :password, autocomplete: "new-password" %>

      <%= f.label :password_confirmation, t("account.password_confirmation") %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password" %>

      <div class="nerv-actions">
        <%= f.submit "[ #{t("account.sign_up_submit")} ]" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</section>
