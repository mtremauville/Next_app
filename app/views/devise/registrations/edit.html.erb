<section class="nerv-auth nerv-auth--single">
  <div class="nerv-panel nerv-auth-form">
    <h2><%= t("account.edit_title") %></h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <%= f.label :email, t("auth.email") %>
      <%= f.email_field :email, autocomplete: "email" %>

      <%= f.label :password do %>
        <%= t("account.new_password") %> <span class="nerv-hint"><%= t("account.keep_password") %></span>
        <% if @minimum_password_length %><span class="nerv-hint"><%= t("account.password_hint", count: @minimum_password_length) %></span><% end %>
      <% end %>
      <%= f.password_field :password, autocomplete: "new-password" %>

      <%= f.label :password_confirmation, t("account.password_confirmation") %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password" %>

      <%= f.label :current_password do %>
        <%= t("account.current_password") %> <span class="nerv-hint"><%= t("account.current_password_hint") %></span>
      <% end %>
      <%= f.password_field :current_password, autocomplete: "current-password" %>

      <div class="nerv-actions">
        <%= f.submit "[ #{t("account.update")} ]" %>
        <%= link_to "[ #{t("account.back")} ]", root_path %>
      </div>
    <% end %>

    <h2 class="nerv-section"><%= t("account.cancel_title") %></h2>
    <p><%= t("account.cancel_text") %></p>
    <%= button_to "[ #{t("account.cancel_button")} ]", registration_path(resource_name),
          method: :delete, class: "nerv-danger",
          form: { data: { turbo_confirm: t("account.cancel_confirm") } } %>
  </div>
</section>
