<% vars = { name: legal_publisher[:name], contact: legal_publisher[:contact], host: legal_publisher[:host],
            retention: legal_log_retention,
            cnil: link_to("CNIL", "https://www.cnil.fr", target: "_blank", rel: "noopener") } %>
<article class="nerv-legal">
  <p><%= link_to "[ ← #{t("legal.back")} ]", root_path %></p>
  <h1><%= t("legal.privacy.title") %></h1>
  <p class="nerv-legal-updated"><%= t("legal.updated", date: legal_updated_on) %></p>

  <% (1..9).each do |number| %>
    <h2><%= t("legal.privacy.s#{number}_title") %></h2>
    <%= t("legal.privacy.s#{number}_body_html", **vars) %>
  <% end %>
</article>
