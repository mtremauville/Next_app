<h1><%= t("dashboard.title") %></h1>

<% if @stats.total.zero? %>
  <p><%= t("dashboard.empty") %></p>
<% else %>
  <div class="nerv-grid">
    <div class="nerv-panel">
      <h2><%= t("dashboard.watched") %></h2>
      <p class="nerv-kpi"><%= @stats.watched_count %></p>
    </div>
    <div class="nerv-panel">
      <h2><%= t("dashboard.episodes") %></h2>
      <p class="nerv-kpi"><%= @stats.episodes_watched %></p>
    </div>
    <div class="nerv-panel">
      <h2><%= t("dashboard.total") %></h2>
      <p class="nerv-kpi"><%= @stats.total %></p>
    </div>
    <div class="nerv-panel">
      <h2><%= t("dashboard.rating") %></h2>
      <p class="nerv-kpi"><%= @stats.average_rating ? "#{@stats.average_rating}/5" : "-" %></p>
    </div>
    <div class="nerv-panel">
      <h2><%= t("dashboard.time") %></h2>
      <p class="nerv-kpi"><%= format_duration(@stats.watched_minutes) %></p>
      <p class="nerv-hint"><%= t("dashboard.time_hint") %></p>
    </div>
  </div>

  <% resume = @stats.resume_items %>
  <% if resume.any? %>
    <section class="nerv-panel nerv-section">
      <h2><%= t("dashboard.resume") %></h2>
      <ul class="nerv-resume-list">
        <% resume.each do |item| %>
          <li class="nerv-resume-row">
            <span><%= link_to resume_item_label(item), resume_item_path(item) %></span>
            <span class="nerv-hint">
              <%= t("dashboard.resume_at", position: format_position(item.position_seconds)) %><% if item.remaining_seconds.to_i.positive? %> · <%= t("dashboard.resume_left", remaining: format_position(item.remaining_seconds)) %><% end %>
            </span>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% rows = @stats.series_rows %>
  <% if rows.any? %>
    <% counts = @stats.series_counts %>
    <section class="nerv-panel nerv-section">
      <h2><%= t("dashboard.series") %></h2>
      <p class="nerv-hint">
        <%= t("dashboard.series_counts", watching: counts["watching"], to_watch: counts["to_watch"], watched: counts["watched"]) %>
      </p>

      <% rows.each do |row| %>
        <div class="nerv-series-row">
          <span class="nerv-series-title status-<%= row.entry.status %>">
            <span class="nerv-led"></span><%= link_to row.entry.title, entry_target_path(row.entry), title: series_state_label(row.entry.status) %>
          </span>
          <span class="nerv-series-count"><%= series_progress_text(row) %></span>
          <%= render "shared/progress_bar", percent: row.percent, state: row.entry.status,
                label: t("dashboard.series_progress", title: row.entry.title) %>
        </div>
      <% end %>
    </section>
  <% end %>

  <section class="nerv-panel nerv-section">
    <h2><%= t("dashboard.by_status") %></h2>
    <% max = [ @stats.by_status.values.max, 1 ].max %>
    <% @stats.by_status.each do |status, count| %>
      <div class="nerv-bar-row">
        <span class="nerv-bar-label status-<%= status %>"><span class="nerv-led"></span><%= status_label(status) %></span>
        <span class="nerv-bar"><span class="nerv-bar-fill status-<%= status %>" style="width: <%= (count * 100.0 / max).round %>%"></span></span>
        <span class="nerv-bar-value"><%= count %></span>
      </div>
    <% end %>
  </section>

  <section class="nerv-panel nerv-section">
    <h2><%= t("dashboard.by_month") %></h2>
    <% months = @stats.by_month %>
    <% max = [ months.map(&:last).max, 1 ].max %>
    <% months.each do |month, count| %>
      <div class="nerv-bar-row">
        <span class="nerv-bar-label"><%= l(Date.strptime(month, "%Y-%m"), format: :month_year) %></span>
        <span class="nerv-bar"><span class="nerv-bar-fill status-watched" style="width: <%= (count * 100.0 / max).round %>%"></span></span>
        <span class="nerv-bar-value"><%= count %></span>
      </div>
    <% end %>
  </section>

  <% genres = @stats.by_genre %>
  <% if genres.any? %>
    <section class="nerv-panel nerv-section">
      <h2><%= t("dashboard.genres") %></h2>
      <% max = genres.first.last %>
      <% genres.each do |genre, count| %>
        <div class="nerv-bar-row">
          <span class="nerv-bar-label"><%= genre %></span>
          <span class="nerv-bar"><span class="nerv-bar-fill status-watched" style="width: <%= (count * 100.0 / max).round %>%"></span></span>
          <span class="nerv-bar-value"><%= count %></span>
        </div>
      <% end %>
    </section>
  <% end %>
<% end %>
