<h1>Catalogue</h1>

<nav class="nerv-tabs" aria-label="Type de titre">
  <%= link_to "[ Films ]", catalog_path(type: "movie", q: @query.presence), class: ("is-active" if @media_type == "movie") %>
  <%= link_to "[ Séries ]", catalog_path(type: "tv", q: @query.presence), class: ("is-active" if @media_type == "tv") %>
</nav>

<%= form_with url: catalog_path, method: :get, class: "nerv-search" do %>
  <%= hidden_field_tag :type, @media_type %>
  <%= search_field_tag :q, @query, placeholder: "Rechercher un film ou une série", "aria-label": "Recherche" %>
  <%= submit_tag "[ Rechercher ]", name: nil %>
<% end %>

<% if @unavailable %>
  <p class="nerv-flash nerv-flash--alert">Le catalogue est momentanément indisponible. Réessaie dans un instant.</p>
<% elsif @result.items.empty? %>
  <p>Aucun résultat pour « <%= @query %> ».</p>
<% else %>
  <h2><%= @query.length >= 2 ? "Résultats" : "Populaires" %></h2>

  <div class="nerv-gallery">
    <%= render partial: "catalog/item", collection: @result.items, as: :item %>
  </div>

  <nav class="nerv-pagination" aria-label="Pagination">
    <% if @result.page > 1 %>
      <%= link_to "[ Précédent ]", catalog_path(type: @media_type, q: @query.presence, page: @result.page - 1) %>
    <% end %>
    <span>Page <%= @result.page %> / <%= @result.total_pages %></span>
    <% if @result.page < @result.total_pages %>
      <%= link_to "[ Suivant ]", catalog_path(type: @media_type, q: @query.presence, page: @result.page + 1) %>
    <% end %>
  </nav>
<% end %>
