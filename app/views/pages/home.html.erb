<h1><%= t("home.title") %></h1>

<% if @stats.total.zero? %>
  <section class="nerv-panel nerv-empty">
    <h2><%= t("home.empty_title") %></h2>
    <p><%= t("home.empty_text") %></p>
    <%= link_to "[ #{t("home.add_first")} ]", new_entry_path, class: "nerv-cta" %>
  </section>
<% else %>
  <div class="nerv-grid nerv-grid--kpi">
    <div class="nerv-panel">
      <h2><%= t("home.watched") %></h2>
      <p class="nerv-kpi"><%= @stats.watched_count %></p>
    </div>
    <div class="nerv-panel">
      <h2><%= t("home.in_list") %></h2>
      <p class="nerv-kpi"><%= @stats.total %></p>
    </div>
    <div class="nerv-panel">
      <h2><%= t("home.time") %></h2>
      <p class="nerv-kpi"><%= format_duration(@stats.watched_minutes) %></p>
    </div>
  </div>

  <div class="nerv-home-columns">
    <section class="nerv-panel nerv-section">
      <h2><%= t("home.in_progress") %></h2>
      <% if @in_progress.any? %>
        <ul class="nerv-mini-list">
          <%= render partial: "pages/mini_entry", collection: @in_progress, as: :entry %>
        </ul>
      <% else %>
        <p class="nerv-hint"><%= t("home.nothing_in_progress") %></p>
      <% end %>
    </section>

    <section class="nerv-panel nerv-section">
      <h2><%= t("home.up_next") %></h2>
      <% if @up_next.any? %>
        <ul class="nerv-mini-list">
          <%= render partial: "pages/mini_entry", collection: @up_next, as: :entry %>
        </ul>
      <% else %>
        <p class="nerv-hint"><%= t("home.nothing_up_next") %></p>
      <% end %>
    </section>
  </div>

  <div class="nerv-actions">
    <%= link_to "[ #{t("nav.new_title")} ]", new_entry_path, class: "nerv-cta" %>
    <%= link_to "[ #{t("home.see_all")} ]", entries_path %>
  </div>
<% end %>
