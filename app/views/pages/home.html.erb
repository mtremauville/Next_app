<div class="container py-4">
  <div class="mb-4">
    <%= render "titles/search_form" %>
  </div>

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Ma watchlist</h1>
    <div class="d-flex gap-2">
      <%= link_to "Films", movies_watchlist_entries_path, class: "btn btn-sm btn-outline-secondary" %>
      <%= link_to "Séries", series_watchlist_entries_path, class: "btn btn-sm btn-outline-secondary" %>
    </div>
  </div>

  <%= render "watchlist_entries/status_filter", base_path: root_path %>

  <% if @watchlist_entries.empty? %>
    <p class="text-muted">Ta watchlist est vide. <%= link_to "Rechercher un titre", titles_path %>.</p>
  <% else %>
    <div class="list-group">
      <%= render partial: "watchlist_entries/entry", collection: @watchlist_entries, as: :entry %>
    </div>
  <% end %>
</div>
