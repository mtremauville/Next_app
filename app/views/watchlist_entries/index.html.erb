<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Ma watchlist</h1>
    <div class="d-flex gap-2">
      <%= link_to "Films", movies_watchlist_entries_path, class: "btn btn-sm btn-outline-secondary" %>
      <%= link_to "Séries", series_watchlist_entries_path, class: "btn btn-sm btn-outline-secondary" %>
    </div>
  </div>

  <%= render "status_filter", base_path: watchlist_entries_path %>

  <% if @watchlist_entries.empty? %>
    <%= render "empty_state" %>
  <% end %>

  <div class="list-group">
    <%= render partial: "entry", collection: @watchlist_entries, as: :entry %>
  </div>

  <%= paginate @watchlist_entries %>
</div>
