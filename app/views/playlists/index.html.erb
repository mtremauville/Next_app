<h1>Playlists</h1>

<p><%= link_to "[ Nouvelle playlist ]", new_playlist_path %></p>

<% if @playlists.empty? %>
  <p>Aucune playlist pour l'instant. Crée-en une pour organiser tes titres.</p>
<% else %>
  <div class="nerv-grid">
    <% @playlists.each do |playlist| %>
      <article class="nerv-panel nerv-playlist">
        <h2><%= link_to playlist.name, playlist_path(playlist) %></h2>
        <p class="nerv-hint"><%= pluralize(playlist.entries.size, "titre") %></p>

        <% if playlist.entries.any? %>
          <%= link_to playlist_path(playlist), class: "nerv-strip", tabindex: -1, aria: { hidden: true } do %>
            <% playlist.entries.first(4).each do |entry| %>
              <%= poster_tag(entry) %>
            <% end %>
          <% end %>
        <% end %>

        <div class="nerv-actions">
          <%= link_to "[ Ouvrir ]", playlist_path(playlist) %>
          <%= link_to "[ Ajouter un titre ]", new_entry_path(playlist_id: playlist.id) %>
          <%= link_to "[ Renommer ]", edit_playlist_path(playlist) %>
          <%= render "shared/confirm_delete",
                title: "Supprimer la playlist ?",
                message: "« #{playlist.name} » sera supprimée. Les titres seront conservés.",
                path: playlist_path(playlist) %>
        </div>
      </article>
    <% end %>
  </div>
<% end %>
