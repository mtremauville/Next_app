<%= form_with model: playlist, class: "nerv-panel" do |f| %>
  <% if playlist.errors.any? %>
    <div class="nerv-errors">
      <% playlist.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <%= f.label :name, t("playlists.form.name") %>
  <%= f.text_field :name %>

  <div class="nerv-actions">
    <%= f.submit "[ #{t("actions.save")} ]" %>
    <%= link_to "[ #{t("actions.cancel")} ]", playlists_path %>
  </div>
<% end %>
