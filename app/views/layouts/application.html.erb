<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Next App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Next App">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app %>
    <%= vite_client_tag %>
    <%= vite_javascript_tag 'application' %>
    <!--
      If using a TypeScript entrypoint file:
        vite_typescript_tag 'application'

      If using a .jsx or .tsx entrypoint, add the extension:
        vite_javascript_tag 'application.jsx'

      Visit the guide for more information: https://vite-ruby.netlify.app/guide/rails
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap">
  </head>

  <body>
    <header class="nerv-header" data-controller="nav" data-action="turbo:before-visit@document->nav#close">
      <%#= link_to "NEXT", (user_signed_in? ? entries_path : root_path), class: "nerv-logo" %>
<% flash_messages = { "notice" => notice, "alert" => alert }.compact_blank %>
<% if flash_messages.any? %>
  <div class="nerv-toasts" data-turbo-temporary>
    <% flash_messages.each do |kind, message| %>
      <% is_alert = kind == "alert" %>
      <div class="nerv-panel nerv-toast <%= "nerv-toast--alert" if is_alert %>"
           role="<%= is_alert ? "alert" : "status" %>"
           data-controller="toast" data-toast-delay-value="<%= is_alert ? 8000 : 4000 %>"
           data-action="mouseenter->toast#pause mouseleave->toast#resume focusin->toast#pause focusout->toast#resume">
        <p><%= message %></p>
        <button type="button" class="nerv-link-button" data-action="toast#dismiss" aria-label="Fermer">[ × ]</button>
        <span class="nerv-toast-bar" style="animation-duration: <%= is_alert ? 8 : 4 %>s"></span>
      </div>
    <% end %>
  </div>
<% end %>
      <%= link_to "NEXT", root_path, class: "nerv-logo" %>
      <% if user_signed_in? %>
        <button type="button" class="nerv-menu-button" data-nav-target="button"
                data-action="nav#toggle" aria-expanded="false" aria-controls="main-nav">[ Menu ]</button>
        <nav id="main-nav" data-nav-target="menu">
          <%= link_to "[ Accueil ]", root_path %>
          <%= link_to "[ Catalogue ]", catalog_path %>
          <%= link_to "[ Ma liste ]", entries_path %>
          <%= link_to "[ Playlists ]", playlists_path %>
          <%= link_to "[ Statistiques ]", dashboard_path %>
          <%= link_to "[ Nouveau titre ]", new_entry_path %>
          <%= button_to "[ Déconnexion ]", destroy_user_session_path, method: :delete, class: "nerv-link-button" %>
        </nav>
      <% end %>
    </header>

    <main class="nerv-main">
      <% if alert %><p class="nerv-flash nerv-flash--alert"><%= alert %></p><% end %>
      <%= yield %>
    </main>
  </body>
</html>
