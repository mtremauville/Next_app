<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || "Next App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Next App">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app %>
    <%= vite_client_tag %>
    <%= vite_javascript_tag 'application' %>
    <!--
      If using a TypeScript entrypoint file:
        vite_typescript_tag 'application'

      If using a .jsx or .tsx entrypoint, add the extension:
        vite_javascript_tag 'application.jsx'

      Visit the guide for more information: https://vite-ruby.netlify.app/guide/rails
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap">
  </head>
  <body>
    <%= tag.div class: "nerv-app",
          data: (user_signed_in? ? { controller: "side-menu", action: "keydown.esc->side-menu#close turbo:before-cache@document->side-menu#reset" } : {}) do %>
      <header class="nerv-header">
        <% if user_signed_in? %>
          <button type="button" class="nerv-menu-toggle" data-side-menu-target="button"
                  data-action="side-menu#toggle" aria-controls="side-menu" aria-expanded="false"
                  aria-label="<%= t("nav.menu") %>">
            <span class="nerv-burger" aria-hidden="true"></span>
          </button>
        <% end %>
        <%= link_to "NEXT", root_path, class: "nerv-logo" %>
      </header>

      <% flash_messages = { "notice" => notice, "alert" => alert }.compact_blank %>
      <% if flash_messages.any? %>
        <div class="nerv-toasts" data-turbo-temporary>
          <% flash_messages.each do |kind, message| %>
            <% is_alert = kind == "alert" %>
            <div class="nerv-panel nerv-toast <%= "nerv-toast--alert" if is_alert %>"
                role="<%= is_alert ? "alert" : "status" %>"
                data-controller="toast" data-toast-delay-value="<%= is_alert ? 8000 : 4000 %>"
                data-action="mouseenter->toast#pause mouseleave->toast#resume focusin->toast#pause focusout->toast#resume">
              <p><%= message %></p>
              <button type="button" class="nerv-link-button" data-action="toast#dismiss" aria-label="<%= t("common.close") %>">[ × ]</button>
              <span class="nerv-toast-bar" style="animation-duration: <%= is_alert ? 8 : 4 %>s"></span>
            </div>
          <% end %>
        </div>
      <% end %>

      <div class="nerv-shell <%= "nerv-shell--no-menu" unless user_signed_in? %>">
        <% if user_signed_in? %>
          <nav id="side-menu" class="nerv-side" data-side-menu-target="panel" aria-label="<%= t("nav.label") %>">
            <div class="nerv-side-links">
              <%= side_link(:home, root_path, %r{\A/\z}) %>
              <%= side_link(:list, entries_path, %r{\A/entries(?!/new)}) %>
              <%= side_link(:playlists, playlists_path, %r{\A/playlists}) %>
              <%= side_link(:catalog, catalog_path, %r{\A/(catalog|movies|series)}) %>
              <%= side_link(:stats, dashboard_path, %r{\A/dashboard}) %>
              <%= side_link(:new_title, new_entry_path, %r{\A/entries/new}) %>
            </div>

            <div class="nerv-side-foot">
              <% unless current_user.guest? %>
                <%= side_link(:account, edit_user_registration_path, %r{\A/users/edit}) %>
              <% end %>
              <%= render "shared/confirm_delete",
                  title: t("sign_out.title"),
                  message: t("sign_out.message"),
                  path: destroy_user_session_path,
                  trigger: t("nav.sign_out"),
                  confirm: t("sign_out.confirm"),
                  danger: false %>
            </div>
          </nav>
          <div class="nerv-side-backdrop" data-side-menu-target="backdrop" data-action="click->side-menu#close" hidden></div>
        <% end %>

        <div class="nerv-content" data-side-menu-target="inert">
          <main class="nerv-main">
            <%= yield %>
          </main>
          <%= render "shared/footer" %>
        </div>
      </div>
    <% end %>
  </body>
</html>
